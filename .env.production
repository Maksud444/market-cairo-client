# =============================================
# PRODUCTION ENVIRONMENT VARIABLES
# Coolify এ এই variables গুলো Environment Variables section এ দিতে হবে
# =============================================

# --- MONGODB (Atlas) ---
MONGODB_URI=mongodb+srv://market-cairo:ZP5x0OXPOLy5YQkO@cluster0.v3mzjbs.mongodb.net/market-cairo?appName=Cluster0

# --- JWT ---
JWT_SECRET=market-cairo-jwt-secret-key-2026-CHANGE-THIS-IN-PRODUCTION
JWT_EXPIRE=30d

# --- FRONTEND URL (your domain) ---
# Coolify এ frontend deploy হওয়ার পর এই URL দিন
FRONTEND_URL=https://yourdomain.com

# --- BACKEND PUBLIC URL (browser থেকে accessible) ---
# Coolify এ backend deploy হওয়ার পর এই URL দিন
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/api
NEXT_PUBLIC_SOCKET_URL=https://api.yourdomain.com

# --- GOOGLE OAUTH ---
GOOGLE_CLIENT_ID=YOUR_GOOGLE_CLIENT_ID
GOOGLE_CLIENT_SECRET=YOUR_GOOGLE_CLIENT_SECRET

# --- ADMIN ---
ADMIN_EMAIL=adminmdbillah420@gmail.com
ADMIN_NAME=Admin

# --- EMAIL (SMTP) - Optional ---
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-gmail-app-password
SMTP_FROM=noreply@yourdomain.com
